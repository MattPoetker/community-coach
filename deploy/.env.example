# Copy to deploy/.env and fill in. Everything without a default is required.

# --- Required ---------------------------------------------------------------
APP_HOST=community.example.com
POSTGRES_PASSWORD=
# openssl rand -hex 64
SECRET_KEY_BASE=

# --- Branding ---------------------------------------------------------------
APP_NAME=Community Coach

# --- Video ------------------------------------------------------------------
# local  — ffmpeg on the worker. No third-party account, but transcoding is heavy: budget
#          roughly 2 CPU-minutes per minute of 1080p video, and keep JOB_CONCURRENCY at 1
#          on a small VPS. Fine for a handful of lessons a week.
# mux / bunny — offload it. Recommended past ~10 hours of source video.
VIDEO_PROVIDER=local
JOB_CONCURRENCY=1

# --- Storage ----------------------------------------------------------------
# Defaults point at the bundled MinIO. For production, point these at S3, R2 or Spaces
# and drop the minio service from the compose file.
S3_BUCKET=community-coach
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Billing ----------------------------------------------------------------
# Leave blank to run a free community. In `direct` mode (the default) the community owner
# puts their own keys in admin settings and money goes straight to them — no platform cut,
# no KYC for whoever runs this server.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=hello@example.com
